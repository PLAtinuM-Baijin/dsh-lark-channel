{
  "name": "@local/dsh-feishu-channel",
  "version": "0.1.0",
  "private": true,
  "description": "飞书（Lark）常驻 channel 插件：WS 长连接收消息，按 chat 路由到独立 dsh Session，并把回答发回飞书。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0",
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./channel-runtime": "./src/channel-runtime.js",
    "./scheduler": "./src/scheduler.js",
    "./memory-store": "./src/memory-store.js",
    "./memory-context": "./src/memory-context.js",
    "./memory-tool": "./src/memory-tool.js",
    "./memory-curator": "./src/memory-curator.js",
    "./history-store": "./src/history-store.js",
    "./history-context": "./src/history-context.js",
    "./reply-tool": "./src/reply-tool.js",
    "./send-file": "./src/send-file.js",
    "./send-text": "./src/send-text.js",
    "./schedule-tool": "./src/schedule-tool.js",
    "./panel-runtime": "./src/panel-runtime.js",
    "./curator-runtime": "./src/curator-runtime.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src/",
    "cordis.patch.yml",
    "AGENTS.md",
    "POWER.md",
    "locale/*.json",
    "icon.svg",
    "ui/index.js",
    "ui/client.js",
    "ui/params.js",
    "ui/presets.js",
    "ui/package.json"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
